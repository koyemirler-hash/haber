rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Yetkili kullanıcı kontrolü
    function yetkili() {
      return request.auth != null && (
        request.auth.token.email == "koyemirler@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol
          in ["admin", "muhtar", "yardimci"]
      );
    }

    // Konuşma ID'sinde kullanıcının katılımcı olup olmadığını kontrol et
    // konusmaId = "uid1_uid2" (sıralanmış)
    function konusmakAtilimcisi(konusmaId) {
      let parts = konusmaId.split('_');
      return parts.size() == 2 &&
             (parts[0] == request.auth.uid || parts[1] == request.auth.uid);
    }

    // Kullanıcılar
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null &&
        (request.auth.uid == userId || yetkili());
      allow delete: if yetkili();
    }

    // Duyurular
    match /announcements/{id} {
      allow read: if true;
      allow create: if yetkili();
      allow update: if request.auth != null;
      allow delete: if yetkili();
      match /comments/{cid} {
        allow read: if true;
        allow create: if request.auth != null;
        // Sadece kendi yorumunu veya yetkili silebilir
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid || yetkili()
        );
        allow update: if false;
      }
    }

    // Köy Sohbeti
    match /chat/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      // Sadece mesaj sahibi veya yetkili silebilir
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid || yetkili()
      );
      allow update: if false;
    }

    // Özel Mesajlar — Split tabanlı katılımcı doğrulaması
    match /ozelMesajlar/{konusmaId} {
      allow read, write: if request.auth != null && konusmakAtilimcisi(konusmaId);
      match /mesajlar/{msgId} {
        allow read: if request.auth != null && konusmakAtilimcisi(konusmaId);
        allow create: if request.auth != null &&
          konusmakAtilimcisi(konusmaId) &&
          request.resource.data.gonderen == request.auth.uid;
        allow delete: if request.auth != null && (
          resource.data.gonderen == request.auth.uid || yetkili()
        );
        allow update: if false;
      }
    }

    // Nostalji
    match /nostalgia/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      // Güncelleme: sadece izin verilen alanlar (reactions, commentCount) veya yetkili
      allow update: if request.auth != null && (
        yetkili() ||
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["reactions", "commentCount", "status", "approvedBy", "approvedAt"])
      );
      allow delete: if yetkili();
      match /comments/{cid} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid || yetkili()
        );
        allow update: if false;
      }
    }

    // İlanlar
    match /ilanlar/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      // Onaylama/düzenleme: sadece yetkili
      allow update: if yetkili();
      // Silme: ilan sahibi veya yetkili
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid || yetkili()
      );
    }

    // Firmalar — sadece yetkili yazar
    match /businesses/{id} {
      allow read: if true;
      allow write: if yetkili();
    }

    // Rehber — sadece kendi kaydını yazar
    match /rehber/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Görüş ve Öneri
    match /questions/{id} {
      allow read: if yetkili();
      allow create: if request.auth != null;
      allow update, delete: if yetkili();
    }

    // Ayarlar
    match /settings/{id} {
      allow read: if true;
      allow create, delete: if yetkili();
      allow update: if yetkili() ||
        (request.auth != null &&
         id == "anket" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["oylar"]));
    }

    // E-posta Sıfırlama Talepleri
    match /resetTalepleri/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if yetkili();
      allow delete: if yetkili();
    }

    // Hikayeler
    match /stories/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      // Güncelleme: sadece viewers alanı veya hikaye sahibi
      allow update: if request.auth != null && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["viewers"]) ||
        resource.data.uid == request.auth.uid ||
        yetkili()
      );
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid || yetkili()
      );
    }

    // Dernek Çalışmaları
    match /dernek/{doc} {
      allow read: if true;
      allow write: if yetkili();
    }

    // Dernek Yönetim Kadrosu
    match /dernekYonetim/{doc} {
      allow read: if true;
      allow write: if yetkili();
    }

  }
}
