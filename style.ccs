:root { --main: #588157; --bg: #f5f7fa; --white: #ffffff; --text: #2d3436; }
body { margin: 0; background: var(--bg); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto; color: var(--text); }
.hidden { display: none !important; }

/* Modern Giriş Kartı */
.auth-card { padding: 40px 20px; text-align: center; }
input { width: 90%; padding: 15px; margin: 10px 0; border: none; border-radius: 15px; background: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.03); font-size: 16px; }
.btn { width: 95%; padding: 16px; background: var(--main); color: white; border: none; border-radius: 15px; font-weight: bold; margin-top: 20px; box-shadow: 0 5px 15px rgba(88, 129, 87, 0.3); }

/* Navigasyon (Dock) */
.nav-bar { position: fixed; bottom: 15px; left: 15px; right: 15px; height: 65px; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); border-radius: 20px; display: flex; box-shadow: 0 10px 30px rgba(0,0,0,0.08); z-index: 1000; }
.nav-bar div { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 10px; font-weight: bold; color: #b2bec3; }
.nav-bar div span { margin-top: 4px; }

/* Instagram Tarzı Postlar */
.feed-container { padding: 10px; padding-bottom: 100px; }
.post-card { background: white; border-radius: 20px; margin-bottom: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.02); }
.post-header { padding: 15px; font-weight: bold; font-size: 14px; border-bottom: 1px solid #f1f1f1; }
.post-content { padding: 15px; font-size: 15px; }
.post-img { width: 100%; display: block; }

/* WhatsApp Tarzı Sohbet */
.chat-container { height: 100vh; display: flex; flex-direction: column; background: #efe7dd; }
.chat-messages { flex: 1; overflow-y: auto; padding: 15px; padding-bottom: 150px; display: flex; flex-direction: column; gap: 10px; }
.msg-bubble { max-width: 80%; padding: 10px 15px; border-radius: 18px; position: relative; font-size: 14px; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
.me { align-self: flex-end; background: #dcf8c6; border-bottom-right-radius: 5px; }
.other { align-self: flex-start; background: white; border-bottom-left-radius: 5px; }
.chat-input-area { position: fixed; bottom: 90px; left: 15px; right: 15px; background: white; padding: 10px; border-radius: 30px; display: flex; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
.chat-input-area input { margin: 0; background: transparent; box-shadow: none; flex: 1; }
.chat-input-area button { background: var(--main); color: white; border: none; width: 45px; height: 45px; border-radius: 50%; }

/* Üst Bar */
.top-bar { background: white; padding: 15px; text-align: center; font-weight: bold; position: sticky; top: 0; z-index: 100; border-bottom: 1px solid #eee; }
