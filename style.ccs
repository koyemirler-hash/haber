:root {
  --ana-renk: #588157; /* Senin sevdiğin o pastel yeşil */
  --vurgu: #a3b18a;
  --arka-plan: #eff2f5;
  --beyaz: #ffffff;
  --yazi: #2b2d42;
  --whatsapp-yesil: #dcf8c6;
}

body {
  margin: 0;
  background-color: var(--arka-plan);
  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: var(--yazi);
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

/* Giriş Ekranını Formluktan Kurtar */
.card {
  background: var(--beyaz);
  border-radius: 25px; /* Köşeleri iyice yuvarla */
  margin: 20px;
  padding: 30px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.05); /* Yumuşak gölge */
  border: none;
}

/* İnputları Modernize Et */
input {
  width: 100%;
  padding: 15px;
  margin: 10px 0;
  border: 2px solid #e9ecef;
  border-radius: 15px;
  background: #f8f9fa;
  font-size: 16px;
  transition: 0.3s;
  box-sizing: border-box;
}

input:focus {
  border-color: var(--ana-renk);
  background: white;
  outline: none;
  box-shadow: 0 0 10px rgba(88, 129, 87, 0.1);
}

/* Butonları "Uygulama Butonu" Yap */
.btn {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, var(--ana-renk), var(--vurgu));
  color: white;
  border: none;
  border-radius: 18px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 5px 15px rgba(88, 129, 87, 0.3);
  margin-top: 10px;
}

.btn:active { transform: scale(0.98); }

/* Alt Menüyü iPhone Dock'u Yap */
.nav-footer {
  position: fixed;
  bottom: 20px;
  left: 20px;
  right: 20px;
  height: 70px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(15px); /* Arkayı bulanıklaştır (Cam efekti) */
  border-radius: 25px;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  border: 1px solid rgba(255,255,255,0.3);
  z-index: 1000;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 11px;
  font-weight: 600;
  color: #6c757d;
}

/* WhatsApp Tarzı Sohbet Balonları */
.chat-box {
  height: calc(100vh - 180px);
  padding: 20px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: #e5ddd5; /* Klasik WhatsApp arka planı */
}

.msg {
  max-width: 80%;
  padding: 10px 15px;
  border-radius: 18px;
  font-size: 15px;
  position: relative;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.sent {
  align-self: flex-end;
  background: var(--whatsapp-yesil);
  border-bottom-right-radius: 4px;
}

.received {
  align-self: flex-start;
  background: var(--beyaz);
  border-bottom-left-radius: 4px;
}

/* Köy Meydanı Kartları (Instagram Tarzı) */
.feed-card {
  background: white;
  margin-bottom: 20px;
  border-radius: 0; /* Feed'de tam genişlik daha modern durur */
  overflow: hidden;
}

.feed-img { width: 100%; display: block; }
