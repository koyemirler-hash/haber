:root { --p: #588157; --bg: #f2f5f8; --white: #fff; --gray: #95a5a6; }
body { margin: 0; background: var(--bg); font-family: 'Segoe UI', system-ui; color: #2c3e50; overflow-x: hidden; }
.hidden { display: none !important; }

/* Overlay */
.overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: 2000; display: flex; align-items: center; justify-content: center; }
.modal { background: white; padding: 30px; border-radius: 30px; width: 85%; text-align: center; }

/* Auth */
.auth-container { height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.auth-box { width: 85%; background: white; padding: 25px; border-radius: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
.auth-logo { width: 80px; margin-bottom: 20px; border-radius: 20px; }
input, textarea { width: 100%; padding: 16px; margin: 10px 0; border: none; background: #f8f9fa; border-radius: 15px; font-size: 16px; box-sizing: border-box; }

/* Buttons */
.btn { border: none; padding: 18px; border-radius: 15px; font-weight: bold; width: 100%; cursor: pointer; transition: 0.3s; }
.btn-main { background: var(--p); color: white; }
.btn-danger { background: #e74c3c; color: white; margin-top: 20px; }

/* Bottom Nav (Dock) */
.bottom-nav { position: fixed; bottom: 20px; left: 15px; right: 15px; height: 75px; background: rgba(255,255,255,0.9); backdrop-filter: blur(15px); border-radius: 25px; display: flex; box-shadow: 0 15px 35px rgba(0,0,0,0.1); z-index: 1000; }
.nav-btn { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 10px; color: var(--gray); font-weight: bold; }
.nav-btn span { font-size: 22px; margin-bottom: 3px; }

/* Feed & Posts */
.app-header { background: white; padding: 20px; text-align: center; font-weight: bold; font-size: 18px; border-bottom: 1px solid #eee; }
.feed-scroll { padding: 15px; padding-bottom: 120px; }
.post-card { background: white; border-radius: 25px; margin-bottom: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.03); overflow: hidden; }
.post-user { padding: 15px; font-weight: bold; color: var(--p); border-bottom: 1px solid #f9f9f9; }
.post-txt { padding: 15px; font-size: 15px; }
.post-img { width: 100%; display: block; }

/* Chat */
.chat-container { height: 100vh; display: flex; flex-direction: column; background: #e5ddd5; }
.chat-area { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 10px; padding-bottom: 100px; }
.msg { max-width: 80%; padding: 12px 16px; border-radius: 20px; font-size: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
.me { align-self: flex-end; background: #dcf8c6; border-bottom-right-radius: 5px; }
.other { align-self: flex-start; background: white; border-bottom-left-radius: 5px; }
.chat-bar { position: fixed; bottom: 105px; left: 15px; right: 15px; background: white; padding: 10px; border-radius: 30px; display: flex; gap: 10px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
.chat-bar input { margin: 0; background: transparent; }
.chat-bar button { background: var(--p); color: white; border: none; width: 50px; height: 50px; border-radius: 50%; font-size: 20px; }
