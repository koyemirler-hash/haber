:root {
  --ana: #588157;
  --vurgu: #a3b18a;
  --arka: #f0f2f5;
  --beyaz: #ffffff;
  --gri: #6c757d;
}

body { margin: 0; font-family: sans-serif; background: var(--arka); overflow-x: hidden; }
.hidden { display: none !important; }

/* Overlay & Modals */
.overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 20px; }
.modal { background: white; padding: 25px; border-radius: 25px; max-width: 400px; width: 100%; }
.terms-box { height: 180px; overflow-y: auto; background: #f8f9fa; padding: 10px; border-radius: 10px; font-size: 13px; margin: 15px 0; border: 1px solid #ddd; }

/* Cards & Inputs */
.card { background: var(--beyaz); margin: 15px; padding: 20px; border-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
input, select { width: 100%; padding: 14px; margin: 8px 0; border: 2px solid #eee; border-radius: 12px; box-sizing: border-box; font-size: 16px; outline: none; }
input:focus { border-color: var(--ana); }

.btn { width: 100%; padding: 15px; border: none; border-radius: 12px; background: var(--ana); color: white; font-weight: bold; font-size: 16px; cursor: pointer; }
.btn-red { background: #d00000; margin-top: 10px; }
.app-logo { display: block; margin: 0 auto 20px; width: 80px; border-radius: 20px; }

/* WhatsApp Chat Style */
.chat-wrapper { height: calc(100vh - 75px); display: flex; flex-direction: column; background: #e5ddd5; }
.chat-container { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 10px; }
.msg-bubble { max-width: 75%; padding: 10px 14px; border-radius: 15px; font-size: 15px; position: relative; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
.me { align-self: flex-end; background: #dcf8c6; border-top-right-radius: 2px; }
.other { align-self: flex-start; background: white; border-top-left-radius: 2px; }
.msg-bubble small { display: block; font-size: 11px; color: var(--ana); font-weight: bold; margin-bottom: 4px; }
.chat-input-bar { background: #f0f0f0; padding: 10px; display: flex; gap: 8px; }
.chat-input-bar input { margin: 0; flex: 1; }
.chat-input-bar button { background: var(--ana); color: white; border: none; width: 50px; border-radius: 50%; font-size: 20px; }

/* Biz Slider */
.biz-slider { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; height: calc(100vh - 75px); }
.biz-item { min-width: 100%; scroll-snap-align: start; display: flex; align-items: center; justify-content: center; }
.biz-content { background: white; margin: 20px; padding: 40px; border-radius: 30px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.1); }

/* Nav Footer */
.nav-footer { position: fixed; bottom: 0; width: 100%; height: 70px; background: rgba(255,255,255,0.9); backdrop-filter: blur(10px); display: flex; border-top: 1px solid #eee; z-index: 100; }
.nav-footer div { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 11px; flex-direction: column; font-weight: bold; color: var(--gri); }
