:root { --main: #588157; --bg: #f4f7f6; --white: #ffffff; }
body { margin: 0; font-family: 'Segoe UI', sans-serif; background: var(--bg); overflow: hidden; }
.hidden { display: none !important; }

/* Giriş Sayfası Tasarımı */
.full-page { height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--main); }
.auth-card { background: white; padding: 40px; border-radius: 30px; width: 85%; max-width: 400px; text-align: center; box-shadow: 0 15px 35px rgba(0,0,0,0.2); }
.auth-logo { width: 80px; border-radius: 20px; margin-bottom: 20px; }
input { width: 100%; padding: 15px; margin: 10px 0; border: none; background: #f0f0f0; border-radius: 12px; box-sizing: border-box; font-size: 16px; }
.btn-main { width: 100%; padding: 15px; border: none; border-radius: 12px; background: var(--main); color: white; font-weight: bold; cursor: pointer; }

/* Üst Bar */
.app-header { height: 60px; background: white; display: flex; align-items: center; padding: 0 15px; border-bottom: 1px solid #eee; position: sticky; top: 0; z-index: 100; }
.menu-toggle { background: none; border: none; font-size: 24px; cursor: pointer; color: var(--main); }
#pageTitle { flex: 1; text-align: center; font-weight: bold; font-size: 18px; }

/* Yan Menü (Sidebar) */
.sidebar { position: fixed; top: 0; left: -280px; width: 280px; height: 100%; background: white; box-shadow: 10px 0 30px rgba(0,0,0,0.1); z-index: 200; transition: 0.3s; }
.sidebar.active { left: 0; }
.sidebar-header { padding: 20px; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
.sidebar-nav { padding: 10px; }
.nav-item { padding: 15px; margin: 5px 0; border-radius: 10px; cursor: pointer; font-weight: 500; transition: 0.2s; }
.nav-item:hover { background: #f0f7f0; color: var(--main); }
.logout { color: #d63031; }

/* Sohbet Balonları */
.chat-container { height: calc(100vh - 130px); overflow-y: auto; padding: 15px; background: #e5ddd5; }
.msg { padding: 10px 15px; border-radius: 15px; margin-bottom: 8px; max-width: 80%; }
.me { align-self: flex-end; background: #dcf8c6; margin-left: auto; }
.other { align-self: flex-start; background: white; }
