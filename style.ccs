:root {
  --ana-renk: #588157; /* Pastel Yeşil */
  --arka-plan: #f7f9fb;
  --kart-bg: #ffffff;
  --yazi-koyu: #2d3436;
  --soft-shadow: 0 10px 20px rgba(0,0,0,0.05);
}

body {
  background-color: var(--arka-plan);
  user-select: none; /* Uygulama hissi için metin seçmeyi kapatıyoruz */
  -webkit-tap-highlight-color: transparent;
}

/* Form gibi duran inputları modernize et */
input[type="text"], input[type="email"], input[type="password"] {
  background: #edf2f4;
  border: 2px solid transparent;
  border-radius: 15px; /* Yuvarlak köşeler */
  padding: 15px;
  transition: all 0.3s ease;
  font-size: 16px;
}

input:focus {
  border-color: var(--ana-renk);
  background: white;
  box-shadow: 0 5px 15px rgba(88, 129, 87, 0.1);
  outline: none;
}

/* Butonları "Form Butonu" olmaktan çıkar */
.btn {
  background: linear-gradient(135deg, #588157, #a3b18a);
  border-radius: 15px;
  padding: 16px;
  border: none;
  color: white;
  font-weight: 700;
  letter-spacing: 1px;
  box-shadow: 0 8px 15px rgba(88, 129, 87, 0.2);
  transform: translateY(0);
  transition: all 0.2s;
}

.btn:active {
  transform: translateY(2px);
  box-shadow: 0 2px 5px rgba(88, 129, 87, 0.2);
}

/* Kartları (Postları) Sosyal Medya Tarzına Getir */
.card {
  border: none;
  border-radius: 25px;
  margin: 15px;
  padding: 20px;
  box-shadow: var(--soft-shadow);
  background: var(--kart-bg);
}

/* Alt Menü (Navigasyon) Uygulama Dock'u Gibi Olsun */
.nav-footer {
  position: fixed;
  bottom: 15px; /* Alttan biraz boşluk bırakarak yüzer hale getir */
  left: 15px;
  right: 15px;
  height: 65px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px); /* Cam efekti */
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  border: 1px solid rgba(255,255,255,0.3);
}
